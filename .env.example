# Project Configuration
PROJECT_PREFIX=lightdance
USER=czli

# Development mode - set to 'true' to enable hot reload and volume mounting
# DEV_MODE=true

# For production, comment out or set to false
DEV_MODE=false

# MongoDB credentials
MONGO_USERNAME=root
MONGO_PASSWORD=nycuee

# File storage configuration
# Music files path - different for development and production
MUSIC_FILE_PATH_DEV=./music_file
MUSIC_FILE_PATH_PROD=/music

# Port configurations
NGINX_PORT=80
API_PORT=8000
MONGO_EXPRESS_PORT=8081
FRONTEND_PORT=3000

# Frontend API configuration  
# Production: relative path through nginx proxy (for Docker)
REACT_APP_API_BASE_URL_PROD=/api

# 身份驗證（backend/auth.py）
# AUTH_SECRET 是簽存取權杖的秘鑰。**沒設的話後端啟動時會臨時產生一把並印出警告**，
# 開發環境可以不設，但每次重啟大家都要重新登入。正式環境務必設一個夠長的隨機字串：
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 刻意不給寫死的預設值——那種預設值會原封不動地上正式環境，而且因為「它能動」
# 所以沒有人會發現。
AUTH_SECRET=
# 權杖有效期（小時），預設 12
AUTH_TOKEN_TTL_HOURS=12

# CORS 允許的來源，逗號分隔。留空 = 用 backend/main.py 裡的 DEFAULT_ORIGINS
# （原本那份寫死的清單），所以不設也不會壞。換部署位置時改這裡就好。
CORS_ORIGINS=

# 建立帳號的邀請碼（backend/main.py 的 /api/register）—— **必填**
#
# 留空 = 這個站台**不開放**自行註冊（/api/register 回 503），帳號要請管理員手動建。
# 刻意不是「留空 = 開放註冊」：漏設一個環境變數的後果不該是「全世界都能在你的
# 資料庫裡開帳號」，而那條路壞掉時畫面上完全正常（註冊成功、登入成功）。
#
# ⚠️ **真正的碼不要寫在這個檔案裡。** 這個檔案在版控中，而這個 repo 是 public
# fork——寫進去的那一刻它就不再是一道門了。要在本機開註冊的話用一次性的環境變數：
#
#   REGISTER_CODE=你的邀請碼 ./start-dev.sh
#
# （shell 的環境變數優先於 --env-file，所以不必動這個檔案）
REGISTER_CODE=
