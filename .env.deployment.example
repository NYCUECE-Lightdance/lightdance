DEV_MODE=false

# MongoDB credentials
#
# ⚠️ **這份是範本，真正的值放在同目錄的 .env.deployment（已經 gitignore）。**
#
# 先前 .env.deployment 本身在版控裡，而這個 repo 是 public fork——正式資料庫的
# root 帳密等於公開發布。改成範本之後，部署機器上要自己有一份填好的檔案：
#
#   cp .env.deployment.example .env.deployment && $EDITOR .env.deployment
#
# 密碼請重新產生，不要沿用舊的（舊的已經公開過，改放到 .gitignore 也收不回來）：
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
MONGO_USERNAME=
MONGO_PASSWORD=
# Frontend API configuration for production build
REACT_APP_API_BASE_URL=http://140.113.160.136:8000/api

FRONTEND_PORT=80

# 身份驗證（backend/auth.py）
# AUTH_SECRET 是簽存取權杖的秘鑰。**沒設的話後端啟動時會臨時產生一把並印出警告**，
# 開發環境可以不設，但每次重啟大家都要重新登入。正式環境務必設一個夠長的隨機字串：
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 刻意不給寫死的預設值——那種預設值會原封不動地上正式環境，而且因為「它能動」
# 所以沒有人會發現。
# ⚠️ 正式環境**一定要填**：docker-compose.prod.yml 設了 REQUIRE_AUTH_SECRET=1，
# 沒填的話後端會啟動失敗（而不是臨時產生一把、每次重啟把所有人登出）
AUTH_SECRET=
# 權杖有效期（小時），預設 12
AUTH_TOKEN_TTL_HOURS=12

# CORS 允許的來源，逗號分隔。留空 = 用 backend/main.py 裡的 DEFAULT_ORIGINS
# （原本那份寫死的清單），所以不設也不會壞。換部署位置時改這裡就好。
CORS_ORIGINS=

# 建立帳號的邀請碼（backend/main.py 的 /api/register）—— **必填**
#
# 留空 = 這個站台**不開放**自行註冊（/api/register 回 503），帳號要請管理員手動建。
# 刻意不是「留空 = 開放註冊」：漏設一個環境變數的後果不該是「全世界都能在你的
# 資料庫裡開帳號」，而那條路壞掉時畫面上完全正常（註冊成功、登入成功）。
#
# 這一份是範本，真正的值填在 .env.deployment（已 gitignore）。邀請碼擋的是濫用
# 不是機密（讀取端點大多是公開的），但它一旦進了版控就等於沒有——理由和上面那組
# 資料庫帳密一樣。
REGISTER_CODE=
